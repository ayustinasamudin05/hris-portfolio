generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  ADMIN
  HR_MANAGER
  EMPLOYEE

  @@map("user_role")
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  SICK
  ON_LEAVE

  @@map("attendance_status")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique(map: "User_email_key")
  passwordHash String
  role         UserRole @default(EMPLOYEE)
  isActive     Boolean  @default(true)
  employeeId   Int      @unique(map: "User_employeeId_key")

  employee Employee @relation(fields: [employeeId], references: [id], map: "User_employeeId_fkey")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user")
}

model Employee {
  id               Int       @id @default(autoincrement())
  employeeCode     String    @unique(map: "Employee_employeeCode_key")
  firstName        String
  lastName         String?
  email            String    @unique(map: "Employee_email_key")
  phone            String?
  dateOfBirth      DateTime?
  hireDate         DateTime
  employmentStatus String    @default("ACTIVE")

  departmentId Int
  positionId   Int

  department Department @relation(fields: [departmentId], references: [id], map: "Employee_departmentId_fkey")
  position   Position   @relation(fields: [positionId], references: [id], map: "Employee_positionId_fkey")

  user        User?
  attendances Attendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId], map: "Employee_departmentId_fkey")
  @@index([positionId], map: "Employee_positionId_fkey")
  @@map("employee")
}

model Department {
  id          Int     @id @default(autoincrement())
  name        String  @unique(map: "Department_name_key")
  description String?

  employees Employee[]
  positions Position[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("department")
}

model Position {
  id           Int     @id @default(autoincrement())
  name         String
  description  String?
  departmentId Int

  department Department @relation(fields: [departmentId], references: [id], map: "Position_departmentId_fkey")
  employees  Employee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, departmentId], map: "Position_name_departmentId_key")
  @@index([departmentId], map: "Position_departmentId_fkey")
  @@map("position")
}

model Attendance {
  id         Int              @id @default(autoincrement())
  employeeId Int
  date       DateTime         @db.Date
  checkIn    DateTime?
  checkOut   DateTime?
  status     AttendanceStatus @default(PRESENT)
  notes      String?          @db.Text

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict, map: "Attendance_employeeId_fkey")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, date], map: "Attendance_employeeId_date_key")
  @@index([date], map: "Attendance_date_idx")
  @@map("attendance")
}
